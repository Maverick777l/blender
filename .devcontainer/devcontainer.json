{
  "name": "Escriptori Nube (KDE + Blender + Chrome)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "runArgs": [
    "--shm-size=2g"
  ],
  "secrets": {
    "VNC_PASSWORD": {
      "description": "OPCIONAL. Deixa-ho buit per entrar a l'escriptori sense contrasenya (només tu hi pots accedir amb el teu compte de GitHub). Si poses una contrasenya, KasmVNC la demanarà amb l'usuari 'admin'."
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Escriptori Virtual",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
